{
  "name": "@clerify/extension",
  "version": "1.0.0",
  "description": "Clerify browser extension for capturing tasks from webpages",
  "private": true,
  "scripts": {
    "dev": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "css-loader": "^7.1.0",
    "style-loader": "^4.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "webextensions": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "warn"
    }
  }
}
