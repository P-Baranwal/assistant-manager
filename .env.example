# Clerify Environment Settings
# Copy to .env.local and fill in your values. Never commit real secrets.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Paddle Client-Side Token (starts with test_ or live_)
VITE_PADDLE_TOKEN=test_your_paddle_token
VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (from Paddle dashboard → Catalog → Prices)
VITE_PADDLE_PRICE_STUDENT_MONTHLY=pri_student_monthly
VITE_PADDLE_PRICE_STUDENT_YEARLY=pri_student_yearly
VITE_PADDLE_PRICE_PRO_MONTHLY=pri_pro_monthly
VITE_PADDLE_PRICE_PRO_YEARLY=pri_pro_yearly

# AI Proxy Endpoint
VITE_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy
